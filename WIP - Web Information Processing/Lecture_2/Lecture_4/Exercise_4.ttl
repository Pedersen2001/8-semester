@prefix : <http://example.org/family-friends-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

# Classes
:Person a owl:Class .

# Properties with their characteristics
:isFriendOf a owl:ObjectProperty , owl:SymmetricProperty ;
    rdfs:domain :Person ;
    rdfs:range :Person .

:isParentOf a owl:ObjectProperty , owl:IrreflexiveProperty , owl:AsymmetricProperty ;
    rdfs:domain :Person ;
    rdfs:range :Person ;
    owl:inverseOf :isChildOf .

:isChildOf a owl:ObjectProperty , owl:IrreflexiveProperty , owl:AsymmetricProperty ; # Child of is also irreflexive/asymmetric
    rdfs:domain :Person ;
    rdfs:range :Person ;
    owl:inverseOf :isParentOf .

:isAncestorOf a owl:ObjectProperty , owl:TransitiveProperty , owl:IrreflexiveProperty , owl:AsymmetricProperty ;
    rdfs:domain :Person ;
    rdfs:range :Person .

:hasSpouse a owl:ObjectProperty , owl:SymmetricProperty , owl:IrreflexiveProperty , owl:FunctionalProperty ; # Assuming monogamous
    rdfs:domain :Person ;
    rdfs:range :Person .

:hasBirthday a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:domain :Person ;
    rdfs:range xsd:date .

# Instances
:john a :Person ;
    :isFriendOf :mary ;
    :isParentOf :alice ;
    :hasSpouse :jane ;
    :hasBirthday "1985-05-15"^^xsd:date .

:mary a :Person ;
    :isFriendOf :john ;
    :hasBirthday "1987-08-25"^^xsd:date .

:alice a :Person ;
    :isChildOf :john ;
    :hasBirthday "2010-04-10"^^xsd:date .

:jane a :Person ;
    :hasSpouse :john ;
    :hasBirthday "1986-02-17"^^xsd:date .